{
  "name": "anime-survivor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format:check": "prettier --check 'src/**/*.{ts,css}' 'tests/**/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,css}' 'tests/**/*.ts'",
    "test": "vitest run",
    "check:arch": "node scripts/check-architecture.mjs",
    "assets:generate": "python scripts/generate_assets.py",
    "assets:validate": "python scripts/validate_sprites.py",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:arch && npm run assets:validate && npm run build",
    "assets:preview": "python scripts/make_contact_sheet.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.1",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.56.0"
  }
}
